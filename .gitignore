# Laravel & PHP .gitignore
# See https://github.com/github/gitignore/blob/main/Laravel.gitignore for updates

/vendor/
/node_modules/
/public/storage
/storage/*.key
/.env
/.env.*
/.idea/
/.vscode/
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
.phpunit.result.cache
/public/hot
/public/storage
/public/mix-manifest.json
/public/css/app.css
/public/js/app.js
/public/build/
# Environment files (but NOT .env.example - that should be committed!)
# .env.example is tracked for reference; local variants are ignored via /.env.* above
/.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project
*.swp
*.bak
*.tmp
*.log

# Composer
composer.phar

# Laravel Telescope
storage/telescope

# Laravel Horizon
storage/horizon

# Laravel Nova
nova-components/

# Laravel Mix
/public/js/manifest.js
/public/js/vendor.js
/public/css/vendor.css

# Laravel Swoole
storage/swoole

# Laravel Octane
storage/octane

# Laravel Valet
/.valet/

# Misc
.env.save
.env.bak
.env.old
.envrc

# Ignore test coverage
coverage/

# Ignore IDE and OS files
.idea/
.vscode/
*.iml
*.sublime*
.DS_Store
Thumbs.db

# Ignore Docker files
.docker/
.docker-compose*

# Ignore Swagger generated docs
storage/api-docs/
